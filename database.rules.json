{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.admin == true)",
        ".write": "auth.token.admin == true",
        "balance": {
          ".write": "false"
        },
        "adminMoney": {
          ".write": "auth.token.admin == true"
        },
        "fine": {
          ".write": "auth.token.admin == true"
        },
        "accountVerified": {
          ".write": "auth.token.admin == true"
        },
        "accountFrozen": {
          ".write": "auth.token.admin == true"
        },
        "job": {
          ".write": "auth.token.admin == true"
        },
        "vehicle": {
          ".write": "auth.uid == $uid"
        },
        "avatar": {
          ".write": "auth.uid == $uid"
        },
        "avatarFrame": {
          ".write": "auth.uid == $uid"
        },
        "profileBgEffect": {
          ".write": "auth.uid == $uid"
        },
        "chatBubbleStyle": {
          ".write": "auth.uid == $uid"
        },
        "profileDescription": {
          ".write": "auth.uid == $uid"
        },
        "nicknameEmoji": {
          ".write": "auth.uid == $uid"
        },
        "subscription": {
          ".write": "auth.token.admin == true"
        },
        "subscriptionExpiry": {
          ".write": "auth.token.admin == true"
        },
        "txlog": {
          ".read": "auth.uid == $uid",
          ".write": "false"
        },
        "notifications": {
          ".read": "auth.uid == $uid",
          ".write": "false"
        },
        "pinnedChats": {
          ".read": "auth.uid == $uid",
          ".write": "auth.uid == $uid"
        },
        "notificationTokens": {
          ".read": false,
          ".write": false
        },
        "pushSettings": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        },
        "pushSubscriptions": {
          ".read": "false",
          ".write": "false"
        }
      }
    },
    "orders": {
      ".read": "auth != null",
      ".write": "false",
      "$orderId": {
        ".write": "false"
      }
    },
    "chat": {
      ".read": "auth != null",
      ".write": "false",
      ".indexOn": [
        "nick",
        "createdAt"
      ]
    },
    "dms": {
      "$key": {
        ".read": "auth != null && $key.contains(auth.uid)",
        ".write": "auth != null && $key.contains(auth.uid)",
        "messages": {
          "$msgId": {
            ".write": "auth != null && $key.contains(auth.uid)"
          },
          ".indexOn": [
            "createdAt"
          ]
        },
        "lastRead": {
          "$uid": {
            ".write": "auth.uid == $uid"
          }
        }
      }
    },
    "market": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$listingId": {
        "status": {
          ".write": "auth.uid == data.child('seller').val() || auth.token.admin == true"
        }
      }
    },
    "walls": {
      "$nick": {
        ".read": "auth != null",
        ".write": "auth.uid == $nick",
        "$postId": {
          ".write": "auth.uid == $nick"
        }
      }
    },
    "apps": {
      ".read": "auth != null",
      ".write": "auth.token.admin == true"
    },
    "notifications": {
      "$uid": {
        ".read": "auth.uid == $uid",
        ".write": "false"
      }
    },
    "janitor_submissions": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$submissionId": {
        "status": {
          ".write": "auth.token.admin == true"
        }
      }
    },
    "pushSubscriptionIndex": {
      ".read": "false",
      ".write": "false"
    },
    "marketplace": {
      ".read": "auth != null",
      ".indexOn": [
        "seller",
        "status",
        "createdAt"
      ],
      "$listingId": {
        ".validate": "!data.exists() ? (newData.hasChildren(['seller','title','pickupAddress']) && newData.child('pickupAddress/lat').isNumber() && newData.child('pickupAddress/lng').isNumber() && newData.child('pickupAddress/text').isString() && newData.child('pickupAddress/text').val().length > 0) : true",
        ".write": "auth != null && (!data.exists() ? newData.child('seller').val() == auth.uid : (data.child('seller').val() == auth.uid || auth.token.admin == true))",
        "status": {
          ".write": "auth != null && (data.parent().child('seller').val() == auth.uid || data.parent().child('buyer').val() == auth.uid || auth.token.admin == true)"
        },
        "buyer": {
          ".write": "auth != null && (data.parent().child('seller').val() == auth.uid || data.parent().child('buyer').val() == auth.uid || auth.token.admin == true)"
        },
        "pickupAddress": {
          ".write": "auth != null && (data.parent().child('seller').val() == auth.uid || auth.token.admin == true)",
          ".validate": "newData.hasChildren(['lat','lng','text']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('text').isString() && newData.child('text').val().length > 0"
        }
      }
    },
    "businessApps": {
      ".read": "auth != null",
      "$appId": {
        ".write": "auth != null && (!data.exists() ? newData.child('owner').val() == auth.uid : (data.child('owner').val() == auth.uid || auth.token.admin == true))",
        ".validate": "!data.exists() ? (newData.child('owner').isString() && newData.child('address').isString() && newData.child('address').val().length > 0 && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('location/lat').isNumber() && newData.child('location/lng').isNumber() && newData.child('location/text').isString() && newData.child('location/text').val().length > 0) : true"
      }
    },
    "businesses": {
      ".read": "auth != null",
      "$bizId": {
        ".write": "auth != null && (data.child('owner').val() == auth.uid || (!data.exists() && newData.child('owner').val() == auth.uid) || auth.token.admin == true)",
        ".validate": "!data.exists() ? (newData.child('owner').isString() && newData.child('address').isString() && newData.child('address').val().length > 0 && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('location/lat').isNumber() && newData.child('location/lng').isNumber() && newData.child('location/text').isString() && newData.child('location/text').val().length > 0) : true"
      }
    },
    "pushOutbox": {
      ".read": "false",
      ".write": "false"
    },
    "notificationTombstones": {
      ".read": "false",
      ".write": "false"
    }
  }
}
